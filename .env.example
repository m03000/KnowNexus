# ==============================
# 应用配置
# ==============================

APP_NAME=KnowNexus
ENVIRONMENT=development
DEBUG=true
CODEX_WATCHER_ENABLED=false


# ==============================
# LLM 配置
# ==============================

LLM_API_KEY=replace-with-your-api-key
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat
LLM_TEMPERATURE=0.0
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2


# JSON 数组格式
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","http://localhost:5173","http://127.0.0.1:5173"]


# ==============================
# 数据库
# ==============================

DATABASE_PATH=var/data/study_help.db
SQLITE_TIMEOUT_SECONDS=30
SQLITE_BUSY_TIMEOUT_MS=5000
RUNTIME_DATA_DIRECTORY=var/data
RUNTIME_LOG_DIRECTORY=var/logs
KNOWLEDGE_GRAPH_SEED_DIRECTORY=data/knowledge_graph
KNOWLEDGE_BASE_DIRECTORY=data/knowledge_base


# ==============================
# 项目源码访问
# ==============================

# JSON 数组格式。
# 正式部署时强烈建议配置。
ALLOWED_PROJECT_ROOTS=[]

SOURCE_SCAN_MAX_FILES=1000
CODE_ANALYSIS_MAX_PARALLELISM=4
AGENT_SHUTDOWN_GRACE_SECONDS=15
SOURCE_FILE_MAX_BYTES=2097152


# ==============================
# 学习资源处理
# ==============================

# 默认最大 1 GiB；视频较大时可按部署资源调整。
LEARNING_RESOURCE_MAX_BYTES=1073741824
# Browser cookies for yt-dlp. Use chrome for Chrome, or leave empty to disable.
LEARNING_VIDEO_COOKIE_BROWSER=edge
LEARNING_WHISPER_MODEL=small
LEARNING_VIDEO_SAMPLE_SECONDS=15
LEARNING_VIDEO_MAX_FRAMES=120
# 图片和扫描 PDF 的 OCR 依赖本机 Tesseract 安装对应语言包。
LEARNING_OCR_LANGUAGES=chi_sim+eng


# ==============================
# 基础 RAG 检索
# ==============================

RAG_VECTOR_DATABASE_PATH=var/data/vector_db
RAG_EMBEDDING_MODEL=BAAI/bge-m3
RAG_RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
RAG_MODELS_LOCAL_FILES_ONLY=true
RAG_MODEL_CACHE_DIRECTORY=var/models/huggingface/hub
RAG_RETRIEVAL_CACHE_TTL_SECONDS=1800
KNOWLEDGE_INGESTION_ENABLED=true
KNOWLEDGE_INGESTION_POLL_SECONDS=2
KNOWLEDGE_INGESTION_BATCH_SIZE=8
KNOWLEDGE_INGESTION_MAX_ATTEMPTS=5
RAG_PROJECT_CODE_COLLECTION=project_code
RAG_PERSONAL_KNOWLEDGE_COLLECTION=personal_knowledge
RAG_USER_MEMORY_COLLECTION=user_memory
# 可选：模型每百万 Token 单价；仅用于结构化运行日志中的成本估算。
LLM_INPUT_PRICE_PER_MILLION=0
LLM_OUTPUT_PRICE_PER_MILLION=0
